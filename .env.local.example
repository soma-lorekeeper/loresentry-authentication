# Copy to .env.local; inject explicitly. Use development credentials only.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=authentication
DB_USERNAME=authentication_svc
DB_PASSWORD=REPLACE_WITH_DEV_DATABASE_PASSWORD
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=auth
SPRING_DATA_REDIS_PASSWORD=REPLACE_WITH_DEV_AUTH_REDIS_PASSWORD
AUTH_GOOGLE_CLIENT_ID=REPLACE_WITH_DEV_GOOGLE_CLIENT_ID
AUTH_GOOGLE_CLIENT_SECRET=REPLACE_WITH_DEV_GOOGLE_CLIENT_SECRET
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback
